<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_logo">

    <!-- === DOME LAYERS === -->
    <target android:name="cloche_dome"><aapt:attr name="android:animation"><objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="1000" android:interpolator="@android:interpolator/fast_out_slow_in" /></aapt:attr></target>

    <!-- === BASE LAYERS === -->
    <target android:name="cloche_base"><aapt:attr name="android:animation"><objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="1000" android:interpolator="@android:interpolator/fast_out_slow_in" /></aapt:attr></target>

    <!-- === HANDLE LAYERS === -->
    <target android:name="cloche_handle"><aapt:attr name="android:animation"><objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:duration="1000" android:interpolator="@android:interpolator/fast_out_slow_in" /></aapt:attr></target>
</animated-vector>
