<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Instruments the :androidApp benchmark variant (com.jkjamies.sampleplatter.*).

      Under self-instrumenting the test APK runs as its own process. Android 11+
      package visibility rules hide other processes from ActivityManager queries
      unless declared — androidx.benchmark's `ProcessTracker.currentProcesses`
      needs to see the target after `am start`, otherwise macrobenchmarks fail
      with "Unable to confirm activity launch completion []".
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

</manifest>
